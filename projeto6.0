                                    if c[3] == p[1]:
                                        quantidade += 1
                                        print('=========================')
                                        print(f'Consultas:{quantidade}')
                                        print(f'Dentista:{c[0]} | Data:{c[1]} | Horário:{c[2]}')
                                if quantidade == 0:
                                    print('Você não tem consultas agendadas.')
                            
                            elif opcao4 == '4':
                                print('\n==== CANCELAR CONSULTA ====')
                                for i in range(len(consultas)):
                                    if consultas[i][3] == p[1]:
                                        print(f'{i} - {consultas[i]}')
                                escolha = input('Qual consulta deseja cancelar:')
                                if escolha.isdigit():
                                    escolha = int(escolha)
                                    if escolha < len(consultas) and consultas[escolha][3] == p[1]:
                                        consultas.pop(escolha)
                                        print('Consulta cancelada com sucesso!')
                                    else:
                                        print('Consulta invalida!')
                            
            else:
                while True:
                    cad = input('CPF não encontrado. Deseja se cadastrar? S/N:').lower().strip()
                    
                    cadastrado = False
                    if cad == 'n' or cad == 'nao':
                        print('Encerrando Cadastro.')
                        break
                    elif cad == 's' or cad == 'sim':
                        while True:
                            nome = input('Digite seu nome completo:').lower()
                            nome_repetido = False
                            for p in pacientes:
                                if p[0] == nome:
                                    nome_repetido = True
                                    break
                            if nome_repetido:
                                print('Nome Já cadastrado.')
                                continue

                            cpf = input('Digite seu CPF:').strip()
                            if not cpf.isdigit() or len(cpf) != 11:
                                print('CPF invalido, Digite 11 numeros.')
                                continue
                            cpf_repetido = False
                            for p in pacientes:
                                if p[1] == cpf:
                                    cpf_repetido = True
                                    break
                            if cpf_repetido:
                                print('CPF ja cadastrado!')
                                continue
                            break
                        senha2 = input('Digite sua senha:').strip()
                        while True:
                            telefone = input('Digite seu telefone:').strip()
                            if not telefone.isdigit() or len(telefone) != 11:
                                print('Telefone invalido, tente novamente EX: XX XXXXXXXXX')
                                continue
                            telefone_repetido = False
                            for p in pacientes:
                                if p[3] == telefone:
                                    telefone_repetido = True
                                    break
                            if telefone_repetido:
                                print('Telefone ja cadastrado!')
                                continue                           
                            break                      
                        pacientes.append([nome, cpf, senha2, telefone])
                        print('Cadastro realizado com sucesso!')
                        cadastrado = True
                        break              
                
                    else:
                        print('Digite Sim ou Não.')                       
    else:
        print('\nDigite uma opção válida.')
